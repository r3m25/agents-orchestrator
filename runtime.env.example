# Keep the actual environment file outside version control.
CAMUNDA_REST_ADDRESS=http://127.0.0.1:8088
CAMUNDA_GRPC_ADDRESS=http://127.0.0.1:26500
# Jira credentials remain outside version control. Set these in the private file referenced by TECH_LEAD_ENV_FILE.
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=your-api-token
# Paths relative to agents-orchestrator (or use absolute paths).
CAMUNDA_PROJECTS_PATH=../../config/projects
# remote (default) clones/fetches/checks out provider repositories in managed workspaces.
REPOSITORY_MODE=remote
REPOSITORY_WORKSPACES_PATH=.runtime/workspaces
# Optional private Git configuration with an HTTPS credential helper (never a URL with a token).
# SOURCE_CONTROL_GIT_CONFIG=/absolute/private/path/gitconfig
# Offline compatibility mode only: REPOSITORY_MODE=local-snapshot
# REPOSITORY_PATHS_FILE=/absolute/path/to/repository-paths.json
CODEX_EXECUTABLE=codex
TECH_LEAD_RUNTIME=.runtime
